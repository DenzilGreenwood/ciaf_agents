{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cognitiveinsight.ai/schemas/permission.schema.json",
  "title": "CIAF Permission Schema",
  "description": "Schema for CIAF permission definitions and RBAC/ABAC rules",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "condition_rule": {
      "type": "object",
      "description": "Attribute-based condition for a permission",
      "properties": {
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "in", "not_in", "contains", "matches_regex", "greater_than", "less_than"],
          "description": "Comparison operator"
        },
        "attribute": {
          "type": "string",
          "description": "Attribute to evaluate"
        },
        "value": {
          "description": "Value to compare against"
        },
        "logic": {
          "type": "string",
          "enum": ["and", "or"],
          "description": "Logic operator for combining conditions"
        }
      },
      "required": ["operator", "attribute"]
    },
    "permission": {
      "type": "object",
      "description": "Permission granting access to an action on resources",
      "properties": {
        "permission_id": {
          "type": "string",
          "description": "Unique permission identifier"
        },
        "action": {
          "type": "string",
          "description": "Action this permission grants (e.g., 'read_record', 'approve_payment')"
        },
        "resource_type": {
          "type": "string",
          "description": "Resource type this applies to ('*' for all types)"
        },
        "effect": {
          "type": "string",
          "enum": ["allow", "deny"],
          "description": "Allow or deny this action"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition_rule"
          },
          "description": "Contextual conditions for this permission"
        },
        "constraints": {
          "type": "object",
          "description": "Additional constraints on permission usage",
          "properties": {
            "time_based": {
              "type": "object",
              "description": "Time-based constraints",
              "properties": {
                "allowed_days": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
                  },
                  "description": "Days when permission is valid"
                },
                "start_time": {
                  "type": "string",
                  "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                  "description": "Start time in HH:MM format"
                },
                "end_time": {
                  "type": "string",
                  "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
                  "description": "End time in HH:MM format"
                },
                "timezone": {
                  "type": "string",
                  "description": "Timezone for time constraints"
                }
              }
            },
            "location_based": {
              "type": "object",
              "description": "Location-based constraints",
              "properties": {
                "allowed_countries": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Allowed country codes"
                },
                "denied_countries": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Denied country codes"
                },
                "ip_whitelist": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Allowed IP addresses/ranges"
                }
              }
            },
            "rate_limit": {
              "type": "object",
              "description": "Rate limiting constraints",
              "properties": {
                "max_per_hour": {
                  "type": "integer",
                  "description": "Maximum uses per hour"
                },
                "max_per_day": {
                  "type": "integer",
                  "description": "Maximum uses per day"
                }
              }
            }
          }
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last update"
        },
        "version": {
          "type": "integer",
          "description": "Permission definition version"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata",
          "additionalProperties": true
        }
      },
      "required": ["permission_id", "action", "resource_type", "effect"]
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/permission"
    }
  ]
}

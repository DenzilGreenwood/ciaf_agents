{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cognitiveinsight.ai/schemas/role.schema.json",
  "title": "CIAF Role Definition Schema",
  "description": "Schema for CIAF role definitions and role-based access control (RBAC)",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "role_definition": {
      "type": "object",
      "description": "Named role with a set of permissions",
      "properties": {
        "role_id": {
          "type": "string",
          "description": "Unique role identifier"
        },
        "name": {
          "type": "string",
          "description": "Role name (e.g., 'data_analyst', 'approver', 'auditor')"
        },
        "display_name": {
          "type": "string",
          "description": "Human-readable role name"
        },
        "description": {
          "type": "string",
          "description": "Description of the role and its purpose"
        },
        "role_type": {
          "type": "string",
          "enum": ["system", "organization", "team", "custom"],
          "description": "Type of role"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of role creation"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last update"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "permission_id": {
                "type": "string",
                "description": "Permission identifier"
              },
              "action": {
                "type": "string",
                "description": "Action granted"
              },
              "resource_type": {
                "type": "string",
                "description": "Resource type"
              }
            },
            "required": ["permission_id", "action", "resource_type"]
          },
          "description": "List of permissions granted by this role"
        },
        "implied_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other roles this role implicitly includes"
        },
        "owner": {
          "type": "string",
          "description": "Owner/creator of the role"
        },
        "organization_id": {
          "type": "string",
          "description": "Organization ID if org-level role"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "deprecated"],
          "description": "Current role status"
        },
        "requires_elevation": {
          "type": "boolean",
          "description": "Whether using this role requires PAM elevation",
          "default": false
        },
        "max_assignments": {
          "type": "integer",
          "description": "Maximum number of principals this role can be assigned to",
          "minimum": 1
        },
        "current_assignments": {
          "type": "integer",
          "description": "Current number of principals with this role"
        },
        "audit_level": {
          "type": "string",
          "enum": ["standard", "enhanced", "forensic"],
          "description": "Audit logging level for actions under this role"
        },
        "metadata": {
          "type": "object",
          "description": "Additional role metadata",
          "additionalProperties": true
        }
      },
      "required": ["role_id", "name", "role_type", "permissions"]
    },
    "role_assignment": {
      "type": "object",
      "description": "Assignment of a role to a principal",
      "properties": {
        "assignment_id": {
          "type": "string",
          "description": "Unique assignment identifier"
        },
        "principal_id": {
          "type": "string",
          "description": "Principal receiving the role"
        },
        "role_id": {
          "type": "string",
          "description": "Role being assigned"
        },
        "assigned_by": {
          "type": "string",
          "description": "Principal who made the assignment"
        },
        "assigned_at": {
          "type": "string",
          "format": "date-time",
          "description": "When assignment was made"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When assignment expires (if temporary)"
        },
        "reason": {
          "type": "string",
          "description": "Reason for the assignment"
        },
        "scope": {
          "type": "object",
          "description": "Scope of the assignment",
          "properties": {
            "organization_id": {
              "type": "string",
              "description": "Organization scope"
            },
            "tenant_id": {
              "type": "string",
              "description": "Tenant scope"
            },
            "resource_types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Specific resource types"
            },
            "resource_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Specific resource IDs"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending", "revoked", "expired"],
          "description": "Assignment status"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata",
          "additionalProperties": true
        }
      },
      "required": ["assignment_id", "principal_id", "role_id", "assigned_by", "assigned_at"]
    }
  },
  "type": "object",
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/role_definition"
      },
      "description": "List of role definitions"
    },
    "assignments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/role_assignment"
      },
      "description": "List of role assignments"
    }
  }
}
